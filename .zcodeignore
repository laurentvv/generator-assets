# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Exceptions: showcase examples (videos and audio committed explicitly)
!docs/exemples/videos/*.mp4

# Local AI agent config (symlink .qwen -> .agents, not representable in Windows git)
.zcode/
.qwen/

# Local configuration (.env — copy .env.example; never versioned)
.env

# pytest
.pytest_cache/

