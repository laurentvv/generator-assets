# No Git LFS (removed 2026-11-27): godot_assets/ is local-only (git-ignored)
# and was purged from history. README/docs showcase images are small WebP
# thumbnails in docs/exemples/godot_assets/ (plain git).

# Vendored browser libraries: exact bytes required (sha256-pinned) — never eol-convert
server/static/vendor/** -text
server/static/*.wav -text
# agents-kit artifacts: byte-frozen skill installs (LF) and the DuckDB ledger (binary)
.agents/skills/** text eol=lf
.agent/*.duckdb* binary
*.cmd -text
*.bat -text

# BEGIN:agents-kit-base
# Managed by agents-kit (files sync) - do not edit inside the markers.
# Installed skills are byte-fingerprinted: they must stay LF on every checkout (2026-10-18 lesson).
.agents/skills/** text eol=lf
# The agent-state DuckDB database is binary (2026-10-16 lesson).
.agent/*.duckdb* binary
# Windows launchers ship CRLF upstream; never translate them (2026-10-31 lesson).
*.cmd -text
*.bat -text
# END:agents-kit-base
