# Git LFS — binary assets of godot_assets/ (audit §2.7, refactor audit plan P1)
#
# Generations live in output/ (ignored by git); godot_assets/ only receives
# VALIDATED reference assets. Their binary versions go through LFS
# so the git history does not grow indefinitely.
# The TEXT files of godot_assets/ (.tres, .tscn, .json, .mhmat) stay
# out of LFS: readable diffs.
#
# Prerequisite: git lfs install (once per clone) — otherwise the
# filter.lfs.required=true filters fail explicitly rather than corrupt.
# New reference binary type → add its line here.

godot_assets/**/*.png   filter=lfs diff=lfs merge=lfs -text
godot_assets/**/*.glb   filter=lfs diff=lfs merge=lfs -text
godot_assets/**/*.ogg   filter=lfs diff=lfs merge=lfs -text
godot_assets/**/*.wav   filter=lfs diff=lfs merge=lfs -text
godot_assets/**/*.blend filter=lfs diff=lfs merge=lfs -text
godot_assets/**/*.thumb filter=lfs diff=lfs merge=lfs -text
